# ========================================================
# RKSkillTube — Root .gitignore
# ========================================================

# --- Legacy & Workspace ---
old/
.vscode/
*.code-workspace
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Environment & Secret Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
*.pem
*.key
*service-account*.json
*credentials*.json

# --- Python & Backend ---
# Bytecode and compiled files (Runtime generated - NEVER commit)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Type Checking & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Celery Task Broker & Worker Artifacts
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

# --- Node.js & Frontend (Next.js) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build Output
.next/
out/
.turbo/

# --- Terraform & Cloud Infrastructure ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# --- Local Media Processing & Temp Files ---
media/
uploads/
temp_media/
*.m3u8
*.ts
*.mp4
!frontend/public/
